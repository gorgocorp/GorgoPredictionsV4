# API (api-sports): la misma llave sirve para API-Basketball y API-Football
APISPORTS_KEY=tu_api_key_aqui

# Base de datos (Docker)
POSTGRES_DB=gorgo_v4
POSTGRES_USER=gorgo
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_HOST_PORT=5435
# Para correr comandos desde el host (fuera de Docker)
DATABASE_URL=postgresql://gorgo:cambia_esta_contraseña@localhost:5435/gorgo_v4

# Interfaz web en Docker (perfil "servicio", se enciende en el corte): http://localhost:8300
WEB_HOST_PORT=8300

# Zona horaria local: define a qué día pertenece cada partido, de los dos deportes
LOCAL_TIMEZONE=America/Mexico_City

# Casa de la API con la que el sistema registra y mide sus parlays
BOOKMAKER=Bet365
# Casas de la API cuyos momios se guardan en cada pierna (en la interfaz eliges con cuál comparar)
PRICE_BOOKMAKERS=Bet365,1xBet

# Sincronización (scheduler único): ciclo regular y corridas previas a cada horario de partidos
SYNC_INTERVAL_HOURS=6
NBA_CURRENT_SEASON=2026-2027
NBA_PREGAME_LEAD_MINUTES=60
FUTBOL_PREGAME_LEAD_MINUTES=45
# Lectura de cierre (sólo momios) para medir el CLV; 0 la apaga
NBA_CLOSING_LEAD_MINUTES=15
FUTBOL_CLOSING_LEAD_MINUTES=0
# Fútbol: días con picks registrados en cada sincronización completa (para parlays de jornada o fin de semana)
FUTBOL_RECORD_DAYS=7

# Proyectos anteriores, sólo para `import-legacy` (se leen sin modificarlos). De su .env se toma
# DATABASE_URL; también se puede dar la URL directa con LEGACY_NBA_DATABASE_URL / LEGACY_FUTBOL_DATABASE_URL.
LEGACY_NBA_ENV=../GorgoNBAParlays/.env
LEGACY_FUTBOL_ENV=../GorgoPredictionsV3/.env
